{
  "manifest_version": 3,
  "name": "Local Coding Agent - Chrome Companion",
  "version": "5.0.0",
  "version_name": "5.0.0",
  "description": "Official bridge for one operator-armed Chrome tab.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Local Coding Agent Chrome Companion",
    "default_popup": "popup.html"
  }
}
