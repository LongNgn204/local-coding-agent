{
  "name": "local-coding-agent-tray",
  "version": "5.0.1",
  "private": true,
  "description": "Local Coding Agent Tray v5.0.1 — cross-platform Electron GUI that supervises the MCP server and the OpenAI Secure MCP Tunnel.",
  "author": "Long Nguyễn",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "main/main.mjs",
  "build": {
    "appId": "com.localcodingagent.tray",
    "productName": "Local Coding Agent",
    "artifactName": "LocalCodingAgentTray-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "main/**",
      "preload.cjs",
      "ui/dist/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "runtime/server",
        "filter": [
          "server.mjs",
          "agent-manager.mjs",
          "browser-bridge.mjs",
          "context-memory.mjs",
          "permission-resolver.mjs",
          "system-power.mjs",
          "package.json",
          "package-lock.json"
        ]
      },
      {
        "from": "../server/node_modules",
        "to": "runtime/server/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSHighResolutionCapable": true
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc --noEmit && vite build",
    "package": "npm run build && electron-builder --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "start": "electron .",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3"
  }
}
